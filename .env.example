# ─── Required for JSearch (LinkedIn/Indeed/Glassdoor aggregator) ───
# Sign up: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# Free tier: 200 requests/month
RAPIDAPI_KEY=
JSEARCH_MONTHLY_LIMIT=200
JSEARCH_MONTHLY_RESERVE=20

# ─── Optional Daily Email Digest (generic SMTP) ───
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
RECIPIENT_EMAIL=

# ─── Daily Digest Timing (IST timezone) ───
ENABLE_SCHEDULER=false
DAILY_EMAIL_HOUR=9
DAILY_EMAIL_TIMEZONE=Asia/Kolkata
DAILY_JOBS_COUNT=15

# ─── Required before exposing a deployment publicly ───
APP_USERNAME=jobhunter
APP_PASSWORD=
REQUIRE_AUTH=false

# ─── Optional persistent database override ───
# Railway automatically uses RAILWAY_VOLUME_MOUNT_PATH when a volume is attached.
DB_PATH=

# ─── Optional: Hunter.io (not actively used — LinkedIn search replaces it) ───
HUNTER_API_KEY=

# ─── Optional: Google Sheets Export ───
GOOGLE_SHEETS_CREDS=credentials.json
GOOGLE_SHEET_ID=

# ─── Legacy / Future Use (not used currently) ───
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
SERPAPI_KEY=
GROQ_API_KEY=
